{
  "name": "three-intrinsic-lens-distortion-cameras-workspace",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:python",
    "setup:python": "bash scripts/setup-python.sh",
    "generate:fixtures": "bash scripts/generate-fixtures.sh",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w three-intrinsic-lens-distortion-cameras",
    "build": "npm run build -w intrinsic-lens-distortion && npm run build -w three-intrinsic-lens-distortion-cameras",
    "verify:opencv": "bash scripts/verify-opencv.sh",
    "build:demo": "npm run build:demo -w three-intrinsic-lens-distortion-cameras",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:check": "bash scripts/pack-check.sh",
    "test:visual": "npm run test:visual -w three-intrinsic-lens-distortion-cameras",
    "test:consumer": "bash scripts/consumer-smoke.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "typescript": "^5.8.3"
  }
}
